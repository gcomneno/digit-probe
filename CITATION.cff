    given-names: "Giancarlo"
    alias: "gcomneno"
repository-code: "https://github.com/gcomneno/digit-probe"
url: "https://github.com/gcomneno/digit-probe"
license: MIT
version: 1.0.0
date-released: "2026-09-18"
keywords:
  - "discrete sequences"
  - "numeric sequences"
  - "statistical analysis"
  - "structural analysis"
  - "research software"
  - "reproducibility"
